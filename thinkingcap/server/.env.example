# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Prefer 3.6 Flash for availability. Free usage depends on your
# Google project's billing tier, eligibility, and available quota.
# Supported list and pricing: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
# Leave GEMINI_FALLBACK_MODELS empty to disable fallbacks.

PORT=8787
# Local-only prototype. Change deliberately if hosting in another environment.
HOST=127.0.0.1
